[Unit]
Description=SE ITAM Django (gunicorn)
After=network.target

[Service]
WorkingDirectory=/root/SE_ITAM-main
Environment=DJANGO_DEBUG=False
Environment=DJANGO_ALLOWED_HOSTS=192.168.70.250,localhost
Environment=CSRF_TRUSTED_ORIGINS=http://192.168.70.250
Environment=DJANGO_SECRET_KEY=change-me
ExecStart=/root/SE_ITAM-main/start-backend.sh
Restart=always

[Install]
WantedBy=multi-user.target
